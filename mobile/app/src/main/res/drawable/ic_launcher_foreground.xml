<?xml version="1.0" encoding="utf-8"?>
<!--
  גבייה — a payment REQUEST, which is the only thing this app sends: a message
  bubble carrying a shekel. Not a wallet, not a coin, not a bank; those say
  "money you have", and this app is about money you are asking for.

  The tail is deliberately broad. A thin spike disappears at 48dp and leaves a
  white rounded square, which is the moment the idea dies — at launcher size
  the tail IS the difference between a bubble and a box.

  The ₪ is the real Noto Sans Bold outline, not a hand-drawn approximation: a
  currency sign someone reads every day is one they notice being slightly off.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- Tail at the bottom-left, where an outgoing message sits in an RTL
         chat: this is a thing you send, not one you received. -->
    <path android:fillColor="#FFFFFF" android:pathData="M41,27 h26 a11,11 0 0 1 11,11 v16 a11,11 0 0 1 -11,11 h-13 c-2.5,4.6 -8,8.2 -15,9.6 c4.2,-3.4 6.4,-6.4 6.6,-9.9 a11,11 0 0 1 -8.6,-10.7 v-16 a11,11 0 0 1 11,-11 z" />

    <!-- Gold is the one warm note against the violet — it is the money, and the
