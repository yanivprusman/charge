<?xml version="1.0" encoding="utf-8"?>
<!--
  Deep violet rather than the green every finance icon defaults to. The app's
  own surface is violet, and on a home screen full of green money apps this is
  the one that gets found.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:startColor="#7C3AED" android:endColor="#4315A0" />
        </aapt:attr>
    </path>

    <!-- A soft light from the top-left, so the tile has depth at 192dp without
         reading as noise at 48dp. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="30" android:centerY="24" android:gradientRadius="86"
                android:startColor="#26FFFFFF" android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>
</vector>
